{
  "name": "ecoverse",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "db:local": "node scripts/start-local-db.js",
    "db:init": "node server/migrate.js --import-legacy",
    "db:demo": "node scripts/seed-demo.js",
    "test:browser": "node tests/browser-check.js",
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:api": "node --watch server/index.js",
    "start": "npm run build && node server/index.js",
    "start:production": "node server/index.js",
    "db:migrate": "node server/migrate.js",
    "admin:grant": "node server/admin.js",
    "test": "node --test tests/*.test.js",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "gsap": "^3.15.0",
    "helmet": "^8.3.0",
    "lenis": "^1.3.26",
    "mysql2": "^3.24.4",
    "nodemailer": "^10.0.1",
    "sharp": "^0.35.4",
    "three": "^0.185.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@playwright/test": "^1.63.0",
    "concurrently": "^10.0.5",
    "vite": "^8.2.2"
  },
  "type": "module"
}
