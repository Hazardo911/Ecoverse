NODE_ENV=development
PORT=3001
TRUST_PROXY=0
# Optional for local development; localhost/127.0.0.1 ports 5173 and PORT are allowed.
APP_ORIGIN=http://localhost:5173
# Required for production only. Without it, local sessions reset on restart.
SESSION_SECRET=
DATA_FILE=data/ecoverse.json
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ecoverse
DB_USER=ecoverse
DB_PASSWORD=
PROOF_DIR=data/proofs
FOREST_THRESHOLDS=0,200,500,1000,2000
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=EcoVerse <no-reply@example.com>
